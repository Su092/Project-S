<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>loadout-tests</AssemblyName>
    <RootNamespace>LoadoutTests</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <!-- 只编译当前有效的断言文件；旧版算例（依赖已作废的链式触发 API）已移除 -->
    <Compile Include="Program.cs" Link="tests\Program.cs" />
    <Compile Include="Bench.cs" Link="tests\Bench.cs" />
    <Compile Include="XpBench.cs" Link="tests\XpBench.cs" />

    <Compile Include="..\..\Assets\_Game\Core\SJson.cs" Link="Core\SJson.cs" />
    <!-- 配置表基础设施：TSV 读取 / 文本源 / 装配 / 校验。
         这些文件零 Unity 依赖，正是为了让断言能在 dotnet 下跑「和运行时完全同一份」的加载逻辑。 -->
    <Compile Include="..\..\Assets\_Game\Core\STsv.cs" Link="Core\STsv.cs" />
    <Compile Include="..\..\Assets\_Game\Core\ISCfgSource.cs" Link="Core\ISCfgSource.cs" />
    <Compile Include="..\..\Assets\_Game\Core\SCfgAddresses.cs" Link="Core\SCfgAddresses.cs" />
    <Compile Include="..\..\Assets\_Game\Core\SCfgSources.cs" Link="Core\SCfgSources.cs" />
    <Compile Include="..\..\Assets\_Game\Core\SCfgLoader.cs" Link="Core\SCfgLoader.cs" />
    <Compile Include="..\..\Assets\_Game\Core\SCfgValidator.cs" Link="Core\SCfgValidator.cs" />
    <Compile Include="..\..\Assets\_Game\Core\SLog.cs" Link="Core\SLog.cs" />
    <Compile Include="..\..\Assets\_Game\Core\LoadoutTypes.cs" Link="Core\LoadoutTypes.cs" />
    <Compile Include="..\..\Assets\_Game\Core\Loadout.cs" Link="Core\Loadout.cs" />
    <Compile Include="..\..\Assets\_Game\Core\GunRuntime.cs" Link="Core\GunRuntime.cs" />
    <Compile Include="..\..\Assets\_Game\Core\RunState.cs" Link="Core\RunState.cs" />
    <Compile Include="..\..\Assets\_Game\Core\SData.cs" Link="Core\SData.cs" />
    <Compile Include="..\..\Assets\_Game\Core\BossState.cs" Link="Core\BossState.cs" />
    <Compile Include="..\..\Assets\_Game\Core\MetaProgress.cs" Link="Core\MetaProgress.cs" />
    <Compile Include="..\..\Assets\_Game\Core\MusicMix.cs" Link="Core\MusicMix.cs" />
    <Compile Include="..\..\Assets\_Game\Core\Splash.cs" Link="Core\Splash.cs" />
    <Compile Include="..\..\Assets\_Game\Core\RunDirector.cs" Link="Core\RunDirector.cs" />
  </ItemGroup>

</Project>
